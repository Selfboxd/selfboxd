{
	"name": "selfboxd",
	"version": "0.0.0",
	"description": "Self-hosted, privacy-first tracker for films, series and books.",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"prepare": "npm run sync || echo ''",
		"sync": "npm run i18n && svelte-kit sync",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --silent",
		"check": "npm run sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "npm run sync && prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"better-sqlite3": "^13.2.0",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@inlang/plugin-message-format": "^4.6.2",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
